# Contact form email delivery (app/api/contact/route.js)
# Copy this file to .env.local and fill in the values, then restart `next dev`.

# Required. SMTP login for info@benchstrength.uk (GoDaddy Workspace Email:
# smtpout.secureserver.net). SMTP_USER is the full mailbox address,
# SMTP_PASS is that mailbox's password.
SMTP_USER=
SMTP_PASS=

# Optional. Canonical origin used for metadata, canonical URLs, sitemap.xml and
# robots.txt. No trailing slash. Defaults to https://benchstrength.uk when unset
# (see lib/site.js). Set this on preview/staging deployments.
NEXT_PUBLIC_SITE_URL=
