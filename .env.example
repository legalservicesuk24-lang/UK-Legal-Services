# Contact form email delivery (app/api/contact/route.js)
# Copy this file to .env.local and fill in the value, then restart `next dev`.

# Required. Web3Forms access key — free, no account needed.
# Get one at https://web3forms.com: enter the destination inbox
# (info@benchstrength.uk) and the key is emailed to that address.
WEB3FORMS_ACCESS_KEY=
